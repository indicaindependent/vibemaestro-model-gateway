# ── copy to .dev.vars locally; set as Wrangler secrets in prod ──
CF_ACCOUNT_ID=your_cloudflare_account_id
AIG_SLUG=your_ai_gateway_slug
GATE_URL=https://gate.example.com

# paid model providers (all optional — free tier works with none of these)
DEEPSEEK_API_KEY=            # platform DeepSeek key (paid default)
VM_ANTHROPIC_KEY=            # platform Claude key; users can also BYO via x-anthropic-key

# per-user soft spend cap enforced in-worker (AI Gateway also caps server-side)
PAID_DAILY_CAP_USD=3.0

# optional error alerts
SCRAMBLEMEBOT_TOKEN=
TELEGRAM_PETE_ID=
